{
  "realm": "scoutid",
  "enabled": true,
  "displayName": "ScoutID (lokal demo)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "sv",
    "en"
  ],
  "defaultLocale": "sv",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "clients": [
    {
      "clientId": "scoutnet2-web",
      "name": "Scoutnet 2 (prototyp)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "scoutnet2-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://127.0.0.1:8080/auth/callback",
        "http://localhost:8080/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:8080/login##http://localhost:8080/login"
      },
      "protocolMappers": [
        {
          "name": "scoutnet_member_no",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "scoutnet_member_no",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
